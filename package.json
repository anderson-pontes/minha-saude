{
  "name": "minha-saude",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:db": "node scripts/test-database.mjs && node scripts/test-phase2.mjs && node scripts/test-shared-access.mjs",
    "test:e2e": "playwright test",
    "test:contacts": "node scripts/test-contact-utils.mjs",
    "import:unicasf": "node scripts/import-unicasf.mjs",
    "test:imports": "python -m unittest discover -s scripts/imports -p test_*.py && node scripts/test-unicasf.mjs",
    "test:import-transport": "node scripts/import-unicasf-remote.mjs --upload --prepare-only && node scripts/import-unicasf-remote.mjs --dry-run --prepare-only && node scripts/test-unicasf-transport.mjs",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "audit:pwa": "node scripts/audit-production-pwa.mjs"
  },
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "overrides": {
    "minimatch": "11.0.4",
    "glob": "14.0.3"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@hookform/resolvers": "6.0.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/supabase-js": "2.118.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.105.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.91.0",
    "react-imask": "7.6.1",
    "react-router-dom": "7.18.5",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "workbox-window": "7.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "sharp": "0.35.5",
    "supabase": "2.122.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "2.0.0"
  }
}
